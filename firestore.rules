rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colecciones de primer nivel. Cada documento lleva `ownerId` con el uid de
    // su dueño; los miembros invitados leen y escriben según el nivel de su rol.
    match /{collection}/{doc} {

      function signedIn() {
        return request.auth != null;
      }

      function ownerOf(data) {
        return signedIn() && data.ownerId == request.auth.uid;
      }

      // El id del documento de miembro es "<uidDelDueño>__<correo>".
      function memberDoc(ownerId) {
        return /databases/$(database)/documents/members/$(ownerId + '__' + request.auth.token.email.lower());
      }

      function isMember(ownerId) {
        return signedIn()
          && request.auth.token.email != null
          && exists(memberDoc(ownerId));
      }

      // Nombre de colección -> clave de módulo en el rol.
      function moduleKey() {
        return collection == 'expenses' || collection == 'incomes' ? 'movimientos'
          : collection == 'fixedCosts' ? 'costos-fijos'
          : collection == 'debts' ? 'deudas'
          : collection == 'budgets' ? 'presupuesto'
          : collection == 'goals' ? 'metas'
          : collection == 'inventory' ? 'inventario'
          : collection == 'shopping' || collection == 'shoppingLists' ? 'compras'
          : collection == 'rates' ? 'tasa'
          : collection == 'roles' || collection == 'members' ? 'usuarios'
          : collection == 'settings' ? 'ajustes'
          : 'catalogos';
      }

      function memberLevel(ownerId) {
        let member = get(memberDoc(ownerId)).data;
        let role = get(/databases/$(database)/documents/roles/$(member.roleId)).data;
        return role.access.get(moduleKey(), 'sin_acceso');
      }

      allow read: if ownerOf(resource.data)
        || (isMember(resource.data.ownerId) && memberLevel(resource.data.ownerId) != 'sin_acceso');

      allow create: if ownerOf(request.resource.data)
        || (isMember(request.resource.data.ownerId) && memberLevel(request.resource.data.ownerId) == 'editar');

      allow update: if (ownerOf(resource.data) && ownerOf(request.resource.data))
        || (isMember(resource.data.ownerId) && memberLevel(resource.data.ownerId) == 'editar');

      allow delete: if ownerOf(resource.data)
        || (isMember(resource.data.ownerId) && memberLevel(resource.data.ownerId) == 'editar');
    }
  }
}
