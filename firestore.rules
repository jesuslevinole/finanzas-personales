rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // La app no tiene sesiones: todos los dispositivos comparten un mismo
    // espacio de datos, identificado por el campo `ownerId`. Firebase entra solo
    // con un usuario anónimo, y estas reglas exigen dos cosas:
    //   1. que haya un usuario autenticado (aunque sea anónimo), y
    //   2. que el documento pertenezca al espacio compartido.
    // Así la base no queda abierta a peticiones sin autenticar, pero cualquiera
    // que abra la app ve y edita lo mismo.
    match /{collection}/{doc} {

      function workspace() {
        return 'casa';
      }

      function signedIn() {
        return request.auth != null;
      }

      allow read: if signedIn() && resource.data.ownerId == workspace();
      allow create: if signedIn() && request.resource.data.ownerId == workspace();
      allow update: if signedIn()
        && resource.data.ownerId == workspace()
        && request.resource.data.ownerId == workspace();
      allow delete: if signedIn() && resource.data.ownerId == workspace();
    }
  }
}
